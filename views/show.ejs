<% layout("/layouts/boilerplate")%> <%//using ejs mate%>
<br><br>
<div class="row">
    <div class="col-8 offset-4" >
    <h3><%=idlisting.title%></h3>
    <div class="card col-6 listing-card">
        <img src="<%=idlisting.image%>" class="card-img-top show-img" alt="listing-image">
        <div class="card-body">

         <p class="card-text">
             
                <%=idlisting.description%> <br>
                    &#8377;<%=idlisting.price.toLocaleString("en-IN")%> <br>
                    <%=idlisting.location%> <br>
                    <%=idlisting.country%> <br>
                
         </p>
        </div>
    </div>
<div class="row">
    <div class="col-4">
<a href="/listings/<%=idlisting._id%>/edit" class="btn btn-dark">Edit</a>
</div>
<div class="col-8">
<form action="/listings/<%=idlisting._id%>?_method=delete" method="post">
    <button class="btn btn-danger">delete listing</button>
</form>

</div>
</div>
</div>
<br><br>
<div class="col-8 offset-4">
    <hr>
    <h6>Leave a Review</h6>
    <form action="/listings/<%= idlisting._id %>/reviews" method="post" class="needs-validation" novalidate >
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]">
        </div>
        <div class="mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" required class="form-control" id="comment" cols="30" rows="10"></textarea>
        <div class="invalid-feedback">
            Please add some review
        </div>
        </div>
        <br>
        <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr>
    <p><b>All Review</b></p>
    <div class="row">
    <%for(review of idlisting.reviews){%>
    <div class="card col-5 ms-3 mb-3">
       <div class="card-body">
        <h5 class="card-title">Username</h5>
        <p class="card-text"><%=review.comment%></p>
        <p class="card-text"><%=review.rating%> &#11088 </p>

       </div>
      <form action="/listings/<%= idlisting._id %>/reviews/<%= review._id %>?_method=DELETE" 
      class="mb-3" method="post">
    <button class="btn btn-sm btn-danger">Delete</button>
</form>
    </div>
    <%}%>
    </div>
</div>


</div>
<br><br>
